{
  "name": "multi-graph-memory",
  "version": "0.2.0",
  "description": "Governed episodic and lesson memory for the multi-app builder. One cluster per build. Local-first, offline-pure core with an injected relevance layer.",
  "license": "MIT",
  "author": "Eyal Nof <verbalogic.project@gmail.com>",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "multi-memory": "./dist/bin/multi-memory.js",
    "multi-memory-mcp": "./dist/bin/multi-memory-mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./core": {
      "types": "./dist/src/core/index.d.ts",
      "default": "./dist/src/core/index.js"
    },
    "./adapters": {
      "types": "./dist/src/adapters/index.d.ts",
      "default": "./dist/src/adapters/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/server.d.ts",
      "default": "./dist/src/mcp/server.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "check:dist": "npm run build && node tooling/check-dist.mjs",
    "check": "npm run check:boundaries && npm run typecheck && npm test && npm run check:dist",
    "verify:pure": "node tooling/verify-pure.mjs",
    "schemas": "node tooling/emit-schemas.mjs",
    "mcp": "node bin/multi-memory-mcp.ts",
    "mcp:http": "node bin/multi-memory-mcp-http.ts",
    "memory": "node bin/multi-memory.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@google/genai": "^2.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false
  }
}
